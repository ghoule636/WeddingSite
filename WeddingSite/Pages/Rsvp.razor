    private RsvpFormModel formModel = new();
    private EditContext? editContext;
   private ValidationMessageStore? messageStore;
   private string? selectedLanguage;
   private string? submissionStatus;
    private bool isSubmitting;
    private bool submissionError;

    private RsvpLanguageContent CurrentContent => contentByLanguage[selectedLanguage!];
    private bool ShowAttendanceDetails => formModel.IsAttending == true;

    protected override void OnInitialized()
    {
        ConfigureEditContext();
    }

    protected override void OnParametersSet()
    {
        selectedLanguage = null;

        var languageFromUri = LanguageHelper.GetLanguageFromUri(Navigation);

        if (languageFromUri is not null &&
        contentByLanguage.ContainsKey(languageFromUri))
        {
            selectedLanguage = languageFromUri;
        }
    }

    private void SetLanguage(string language)
    {
        if (!contentByLanguage.ContainsKey(language))
        {
            return;
        }

        selectedLanguage = language;
        submissionStatus = null;
        submissionError = false;
        LanguageHelper.NavigateToCurrentWithLanguage(Navigation, language);
    }

    private void ResetLanguage()
    {
        selectedLanguage = null;
        submissionStatus = null;
        submissionError = false;
        LanguageHelper.NavigateToCurrentWithLanguage(Navigation, null);
    }

    private async Task HandleValidSubmit()
    {
        if (selectedLanguage is null || isSubmitting)
        {
            return;
        }

        submissionStatus = null;
        submissionError = false;

        var endpoint = ResolveRsvpEndpoint();
        if (endpoint is null)
        {
            submissionStatus = CurrentContent.ErrorMessage;
            submissionError = true;
            StateHasChanged();
            return;
        }

        isSubmitting = true;

        try
        {
            var payload = BuildRequestPayload();
            using var response = await Http.PostAsJsonAsync(endpoint, payload);

            if (response.IsSuccessStatusCode)
            {
                var success = await response.Content.ReadFromJsonAsync<RsvpSuccessResponse>();
                submissionStatus = success?.Message ?? CurrentContent.SuccessMessage;
                submissionError = false;

                formModel = new RsvpFormModel();
                ConfigureEditContext();

                NavigateToHome();
            }
            else
            {
                var error = await response.Content.ReadFromJsonAsync<RsvpErrorResponse>();
                submissionStatus = error?.Error ?? CurrentContent.ErrorMessage;
                submissionError = true;
            }
        }
        catch (Exception exception)
        {
            Console.Error.WriteLine($"RSVP submission failed: {exception}");
            submissionStatus = CurrentContent.ErrorMessage;
            submissionError = true;
        }
        finally
        {
            isSubmitting = false;
            StateHasChanged();
        }
    }

    private string? ResolveRsvpEndpoint()
    {
        var endpoint = Configuration["RsvpApi:Endpoint"];
        return string.IsNullOrWhiteSpace(endpoint) ? null : endpoint;
    }

    private RsvpRequestPayload BuildRequestPayload()
    {
        var language = selectedLanguage ?? LanguageHelper.English;
        var trimmedName = formModel.Name?.Trim() ?? string.Empty;
        var trimmedPhone = formModel.Phone?.Trim() ?? string.Empty;
        var allergyNotes = string.IsNullOrWhiteSpace(formModel.AllergyNotes)
            ? null
            : formModel.AllergyNotes.Trim();

        return new RsvpRequestPayload
        {
            Name = trimmedName,
            Phone = trimmedPhone,
            IsAttending = formModel.IsAttending == true,
            GuestCount = formModel.IsAttending == true ? formModel.GuestCount : null,
            AllergyNotes = allergyNotes,
            Language = language
        };
    }

    private void ConfigureEditContext()
    {
        if (editContext is not null)
        {
            editContext.OnValidationRequested -= HandleValidationRequested;
            editContext.OnFieldChanged -= HandleFieldChanged;
        }

        editContext = new EditContext(formModel);
        messageStore = new ValidationMessageStore(editContext);
        editContext.OnValidationRequested += HandleValidationRequested;
        editContext.OnFieldChanged += HandleFieldChanged;
    }

    private void NavigateToHome()
    {
        var baseDestination = LanguageHelper.AppendLanguageQuery("/", selectedLanguage);
        var separator = baseDestination.Contains('?') ? "&" : "?";
        var destination = $"{baseDestination}{separator}rsvp=success";
        Navigation.NavigateTo(destination);
    }

    private void HandleValidationRequested(object? sender, ValidationRequestedEventArgs args) =>
    ValidateForm();

    private void HandleFieldChanged(object? sender, FieldChangedEventArgs args)
    {
        submissionStatus = null;
        submissionError = false;
        ValidateForm(args.FieldIdentifier);
    }

    private void ValidateForm(FieldIdentifier? fieldToValidate = null)
    {
        if (messageStore is null || editContext is null)
        {
            return;
        }

        if (selectedLanguage is null)
        {
            messageStore.Clear();
            editContext.NotifyValidationStateChanged();
            return;
        }

        if (fieldToValidate is null)
        {
            messageStore.Clear();
            ValidateName();
            ValidatePhone();
            ValidateGuestCount();
            ValidateAttendance();
        }
        else
        {
            messageStore.Clear(fieldToValidate.Value);

            switch (fieldToValidate.Value.FieldName)
            {
                case nameof(RsvpFormModel.Name):
                    ValidateName();
                    break;
                case nameof(RsvpFormModel.Phone):
                    ValidatePhone();
                    break;
                case nameof(RsvpFormModel.GuestCount):
                    ValidateGuestCount();
                    break;
                case nameof(RsvpFormModel.IsAttending):
                    ValidateAttendance();
                    ValidateGuestCount();
                    break;
            }
        }

        editContext.NotifyValidationStateChanged();
    }

    private void ValidateName()
    {
        if (string.IsNullOrWhiteSpace(formModel.Name))
        {
            messageStore?.Add(new FieldIdentifier(formModel, nameof(RsvpFormModel.Name)), CurrentContent.NameRequiredError);
        }
    }

    private void ValidatePhone()
    {
        if (string.IsNullOrWhiteSpace(formModel.Phone))
        {
            messageStore?.Add(new FieldIdentifier(formModel, nameof(RsvpFormModel.Phone)), CurrentContent.PhoneRequiredError);
        }
    }

    private void ValidateGuestCount()
    {
        var field = new FieldIdentifier(formModel, nameof(RsvpFormModel.GuestCount));

        messageStore?.Clear(field);

        if (formModel.IsAttending != true)
        {
            return;
        }

        if (formModel.GuestCount is null)
        {
            messageStore?.Add(field, CurrentContent.GuestCountRequiredError);
            return;
        }

        if (formModel.GuestCount < 0 || formModel.GuestCount > 12)
        {
            messageStore?.Add(field, CurrentContent.GuestCountRangeError);
        }
    }

    private void ValidateAttendance()
    {
        if (formModel.IsAttending is null)
        {
            messageStore?.Add(new FieldIdentifier(formModel, nameof(RsvpFormModel.IsAttending)),
            CurrentContent.AttendanceRequiredError);
        }
    }

    private sealed class RsvpRequestPayload
    {
        public string Name { get; set; } = string.Empty;
        public string Phone { get; set; } = string.Empty;
        public bool IsAttending { get; set; }
        public int? GuestCount { get; set; }
        public string? AllergyNotes { get; set; }
        public string Language { get; set; } = LanguageHelper.English;
    }

    private sealed class RsvpSuccessResponse
    {
        public string? Message { get; set; }
    }

    private sealed class RsvpErrorResponse
    {
        public string? Error { get; set; }
    }

    private sealed class RsvpLanguageContent
    {
        public required string PageTitle { get; init; }
        public required string Heading { get; init; }
        public required string Subheading { get; init; }
        public required string DetailsTitle { get; init; }
        public required string LocationLabel { get; init; }
        public required string LocationValue { get; init; }
        public required string TimeLabel { get; init; }
        public required string TimeValue { get; init; }
        public required string DressCodeLabel { get; init; }
        public required string DressCodeValue { get; init; }
        public required string CelebrationLabel { get; init; }
        public required string CelebrationValue { get; init; }
        public required string PhotoAltPrimary { get; init; }
        public required string NameLabel { get; init; }
        public required string NamePlaceholder { get; init; }
        public required string PhoneLabel { get; init; }
        public required string PhonePlaceholder { get; init; }
        public required string PhoneHelp { get; init; }
        public required string GuestCountLabel { get; init; }
        public required string GuestCountHelp { get; init; }
        public required string AttendanceQuestion { get; init; }
        public required string AttendanceYes { get; init; }
        public required string AttendanceNo { get; init; }
        public required string AllergyLabel { get; init; }
        public required string AllergyPlaceholder { get; init; }
        public required string AllergyHelp { get; init; }
        public required string SubmitLabel { get; init; }
        public required string ChangeLanguageLabel { get; init; }
        public required string SuccessMessage { get; init; }
        public required string NameRequiredError { get; init; }
        public required string PhoneRequiredError { get; init; }
        public required string GuestCountRequiredError { get; init; }
        public required string GuestCountRangeError { get; init; }
        public required string AttendanceRequiredError { get; init; }
        public required string ErrorMessage { get; init; }
    }

    private sealed class RsvpFormModel
    {
        public string? Name { get; set; }
        public string? Phone { get; set; }
        public int? GuestCount { get; set; }
        public bool? IsAttending { get; set; }
        public string? AllergyNotes { get; set; }
    }
}
